# Server
PORT=5000
NODE_ENV=development

# Client (admin) origin allowed by CORS
CLIENT_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aquabrim_cms
# Or individual parts (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=aquabrim_cms

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Default admin (used by the seed script)
ADMIN_EMAIL=admin@aquabrim.com
ADMIN_PASSWORD=Admin@123
